== CommitLinesSchema

CREATE TABLE IF NOT EXISTS whodunit_commit_lines (
	repo_id    VARCHAR(64)  NOT NULL,
	commit_sha VARCHAR(64)  NOT NULL,
	line_hash  BIGINT       NOT NULL,
	file_path  VARCHAR(512) NOT NULL,
	synced_at  BIGINT       NOT NULL,
	PRIMARY KEY (repo_id, commit_sha, line_hash)
);

== index
CREATE INDEX idx_whodunit_commit_lines_hash ON whodunit_commit_lines (repo_id, line_hash)
== upsertCommitLine(mysql=false)
INSERT INTO whodunit_commit_lines (repo_id, commit_sha, line_hash, file_path, synced_at) VALUES (?, ?, ?, ?, ?) ON CONFLICT(repo_id, commit_sha, line_hash) DO UPDATE SET file_path=excluded.file_path, synced_at=excluded.synced_at
== upsertCommitLine(mysql=true)
INSERT INTO whodunit_commit_lines (repo_id, commit_sha, line_hash, file_path, synced_at) VALUES (?, ?, ?, ?, ?) ON DUPLICATE KEY UPDATE file_path=VALUES(file_path), synced_at=VALUES(synced_at)
