== upsertLine(mysql=false)
INSERT INTO whodunit_event_lines (repo_id, line_hash, first_at, synced_at) VALUES (?, ?, ?, ?) ON CONFLICT(repo_id, line_hash) DO UPDATE SET synced_at=excluded.synced_at
== upsertLine(mysql=true)
INSERT INTO whodunit_event_lines (repo_id, line_hash, first_at, synced_at) VALUES (?, ?, ?, ?) ON DUPLICATE KEY UPDATE synced_at=VALUES(synced_at)
