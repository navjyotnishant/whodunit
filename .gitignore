/dun
/dist/
*.test
/dun-report.html
# Fetched from upstream by setup-datalake.sh, not vendored. Our copy of the
# compose file differed from Apache's by nine lines of comment, so keeping it
# bought nothing and went stale every DevLake release.
deploy/devlake/.env
deploy/devlake/docker-compose.yml
deploy/devlake/env.example

# Docusaurus site (website/). node_modules and the build output are
# regenerated by `npm ci && npm run build`; package-lock.json is committed
# so CI installs the same tree that was tested here.
website/node_modules/
website/build/
website/.docusaurus/
.playwright-mcp/
